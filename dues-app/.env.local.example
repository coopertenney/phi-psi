# Copy to .env.local. With NONE of these set, the app runs entirely on the
# in-memory store and the practice bank feed — no Supabase project, no Plaid
# account, no auth. That is the supported way to develop.

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bypasses RLS. The ONLY key that can read sync_state, where the bank access
# token lives. Server-side only — never prefix it with NEXT_PUBLIC_, and set it
# in Vercel rather than committing it anywhere.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Plaid ----
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Permits creating a NEW bank connection. Plaid's Trial plan allows ten
# connections for the lifetime of the account and removing one does not give it
# back, so this is set for the single deploy that connects the account and
# removed immediately after. Reconnecting never needs it.
PLAID_ALLOW_NEW_ITEM=

# Optional: lets Plaid notify us the moment new transactions land, instead of
# waiting for the daily check.
PLAID_WEBHOOK_URL=

# ---- The daily check ----
# Vercel sends this as a bearer token to /api/cron/sync. Without it the route
# refuses every request, including Vercel's.
CRON_SECRET=
