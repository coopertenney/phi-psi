# Copy to .env.local and fill in once your Supabase project exists.
# WITHOUT these, the app runs on the built-in mock data (the seed roster),
# so you can develop the full UI before the backend is live.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key (Project Settings -> API -> service_role). Server-only —
# never expose to the browser. Used by the Stripe webhook to write payments,
# bypassing RLS (the webhook has no logged-in user session to run RLS as).
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (dues payments). Get these from the Stripe Dashboard once a chapter
# officer has an account set up. Test mode keys start with sk_test_/whsec_test
# equivalents; use sk_live_/whsec_... only once you're ready to take real money.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Used to build the Checkout success/cancel redirect URLs. Falls back to the
# request's Origin header if unset, so this is mainly needed for local testing
# behind proxies or when Origin isn't reliable (e.g. some webhook replays).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web Push (notifications). Generate a pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# The PUBLIC key is exposed to the browser (needed to subscribe); the PRIVATE
# key is server-only (signs the push messages). VAPID_SUBJECT is a mailto: or
# https: contact URL the push service can reach you at.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@phikappapsi.example
